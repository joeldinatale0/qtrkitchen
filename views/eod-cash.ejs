<%- include('partials/head', { title: "EOD Cash Sheet — QTR Kitchen Ordering" }) %>
<%- include('partials/topbar') %>

<div class="eod-page">
  <div class="eod-card">
    <div class="eod-head">
      <div class="eod-logo">
        <div class="mark"></div>
        <div class="wordmark">Coffee<br>QTR</div>
      </div>
      <span class="eod-pill"><%= currentUser.name %></span>
    </div>

    <h1 class="eod-title">EOD Cash Sheet</h1>

    <% if (saved) { %>
      <div class="eod-saved-banner">Saved — <%= formatDate(reportDate) %>'s cash sheet has been submitted.</div>
    <% } %>

    <form method="GET" action="/eod-cash" class="eod-meta">
      <div>
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= reportDate %>" max="<%= today %>" onchange="this.form.submit()" />
      </div>
    </form>

    <form method="POST" action="/eod-cash" id="eodForm">
      <input type="hidden" name="report_date" value="<%= reportDate %>" />

      <table class="eod-table">
        <thead>
          <tr>
            <th>Till Amount<br>(Counted)</th>
            <th>EFTPOS<br>Sales</th>
            <th>Uber<br>Sales</th>
            <th>Cash<br>Sales</th>
            <th>Cash Amount</th>
            <th>Discrepancy</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Till Amount (Counted)">
              $ <input type="number" step="0.01" name="till_amount" id="till_amount"
                  value="<%= existing ? (existing.till_amount_cents / 100).toFixed(2) : '' %>" required />
            </td>
            <td data-label="EFTPOS Sales">
              $ <input type="number" step="0.01" name="eftpos_sales" id="eftpos_sales"
                  value="<%= existing ? (existing.eftpos_sales_cents / 100).toFixed(2) : '' %>" required />
            </td>
            <td data-label="Uber Sales">
              $ <input type="number" step="0.01" name="uber_sales" id="uber_sales"
                  value="<%= existing ? (existing.uber_sales_cents / 100).toFixed(2) : '' %>" required />
            </td>
            <td data-label="Cash Sales">
              $ <input type="number" step="0.01" name="cash_sales" id="cash_sales"
                  value="<%= existing ? (existing.cash_sales_cents / 100).toFixed(2) : '' %>" required />
            </td>
            <td data-label="Cash Amount">
              $ <input type="number" step="0.01" name="cash_amount" id="cash_amount"
                  value="<%= existing ? (existing.cash_amount_cents / 100).toFixed(2) : '' %>" required />
            </td>
            <td data-label="Discrepancy" class="eod-discrepancy <%= !existing ? '' : (existing.discrepancy_cents < 0 ? 'short' : existing.discrepancy_cents > 0 ? 'over' : 'even') %>" id="discrepancy_display">
              <%= existing ? '$' + (existing.discrepancy_cents / 100).toFixed(2) : '—' %>
            </td>
          </tr>
        </tbody>
      </table>

      <p class="muted" style="margin-top: 12px;">
        Discrepancy = Cash Amount &minus; Cash Sales (negative = short, positive = over).
      </p>

      <button class="btn btn-eod" type="submit" style="margin-top: 16px;">
        <%= existing ? 'Update' : 'Submit' %> Cash Sheet
      </button>
    </form>
  </div>

  <% if (recent.length > 0) { %>
    <h2 style="margin-top: 40px;">Recent Submissions</h2>
    <div class="card">
      <table>
        <thead>
          <tr><th>Date</th><th>Till Amount</th><th>Cash Sales</th><th>Cash Amount</th><th>Discrepancy</th><th></th></tr>
        </thead>
        <tbody>
          <% recent.forEach(function(s) { %>
            <tr>
              <td><%= formatDate(s.report_date) %></td>
              <td>$<%= (s.till_amount_cents / 100).toFixed(2) %></td>
              <td>$<%= (s.cash_sales_cents / 100).toFixed(2) %></td>
              <td>$<%= (s.cash_amount_cents / 100).toFixed(2) %></td>
              <td class="eod-discrepancy <%= s.discrepancy_cents < 0 ? 'short' : s.discrepancy_cents > 0 ? 'over' : 'even' %>">
                $<%= (s.discrepancy_cents / 100).toFixed(2) %>
              </td>
              <td><a class="btn btn-small" href="/eod-cash?date=<%= s.report_date %>">Edit</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  const cashSalesInput = document.getElementById('cash_sales');
  const cashAmountInput = document.getElementById('cash_amount');
  const discrepancyDisplay = document.getElementById('discrepancy_display');

  function money(cents) {
    return (cents < 0 ? '-$' : '$') + (Math.abs(cents) / 100).toFixed(2);
  }

  function recompute() {
    const cashSales = Math.round((parseFloat(cashSalesInput.value) || 0) * 100);
    const cashAmount = Math.round((parseFloat(cashAmountInput.value) || 0) * 100);
    const discrepancy = cashAmount - cashSales;

    discrepancyDisplay.textContent = money(discrepancy);
    discrepancyDisplay.classList.remove('short', 'over', 'even');
    discrepancyDisplay.classList.add(discrepancy < 0 ? 'short' : discrepancy > 0 ? 'over' : 'even');
  }

  cashSalesInput.addEventListener('input', recompute);
  cashAmountInput.addEventListener('input', recompute);
</script>

</body>
</html>
