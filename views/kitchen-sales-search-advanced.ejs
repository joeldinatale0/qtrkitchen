<%- include('partials/head', { title: "Advanced Sales Search — QTR Kitchen Ordering" }) %>
<%- include('partials/topbar') %>

<div class="container">
  <p class="muted"><a href="/kitchen/sales-search">&larr; Sales Search</a></p>
  <h1>Advanced Sales Search</h1>
  <p class="subtitle">
    Exact term matching: pick shops, item name(s), and a date range yourself. Results are emailed to you —
    a wide search can take a few minutes to pull.
  </p>

  <% if (queued) { %>
    <div class="success-banner">
      Search started — results will be emailed shortly to <%= reportsEmail %>.
    </div>
  <% } %>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/kitchen/sales-search/advanced" class="card">
    <label for="terms">Item name(s) — one per line (matches anything containing this text)</label>
    <textarea id="terms" name="terms" rows="4" placeholder="e.g.&#10;Wild Blanc&#10;Mont Blanc&#10;Strawberry Matcha"><%= termsRaw %></textarea>

    <div style="margin-top: 16px;">
      <label>Shops</label>
      <div style="display: flex; gap: 20px; flex-wrap: wrap;">
        <% shopOptions.forEach(function(opt) { %>
          <label style="display: flex; align-items: center; gap: 6px; text-transform: none; letter-spacing: 0; opacity: 1; font-size: 14px;">
            <input type="checkbox" name="shops" value="<%= opt.slug %>" style="width: auto;" <%= selectedShops.includes(opt.slug) ? 'checked' : '' %> />
            <%= opt.name %>
          </label>
        <% }) %>
      </div>
    </div>

    <div style="display: flex; gap: 20px; margin-top: 16px; flex-wrap: wrap;">
      <div>
        <label for="start">Start date</label>
        <input type="date" id="start" name="start" value="<%= start %>" required />
      </div>
      <div>
        <label for="end">End date</label>
        <input type="date" id="end" name="end" value="<%= end %>" required />
      </div>
    </div>

    <button class="btn btn-filled" type="submit" style="margin-top: 20px;">Search</button>
  </form>
</div>

</body>
</html>
