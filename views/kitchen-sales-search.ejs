<%- include('partials/head', { title: "Sales Search — QTR Kitchen Ordering" }) %>
<%- include('partials/topbar') %>

<div class="container">
  <p class="muted"><a href="/kitchen">&larr; Admin</a></p>
  <h1>Sales Search</h1>
  <p class="subtitle">
    Ask any sales question in plain English. Results are emailed to you — a wide search can take a few minutes to pull.
  </p>

  <% if (!aiConfigured) { %>
    <p class="error">ANTHROPIC_API_KEY is missing — ask Joel to add it in Render before this can work.</p>
  <% } %>

  <% if (queued) { %>
    <div class="success-banner">
      Search started — results will be emailed shortly to <%= reportsEmail %>.
    </div>
  <% } %>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="POST" action="/kitchen/sales-search" class="card">
    <label for="query">What do you want to know?</label>
    <textarea id="query" name="query" rows="3" placeholder="e.g. find me the grab and go sales for the past 30 days and break it down into flavour categories"><%= query %></textarea>
    <button class="btn btn-filled" type="submit" style="margin-top: 16px;">Search</button>
  </form>

  <div class="card" style="margin-top: 20px;">
    <p class="item-name" style="margin-bottom: 8px;">Example questions</p>
    <ul style="margin: 0; padding-left: 20px; line-height: 1.8; color: var(--muted, #666);">
      <li>Find me the grab and go sales for the past 30 days and break it down into flavour categories</li>
      <li>Iced drinks sales for the past 30 days, ranked highest to lowest, across all shops</li>
      <li>How did Wild Blanc sell at Essendon over the last 2 weeks?</li>
      <li>Cookie sales at Highpoint for October, broken down by flavour</li>
    </ul>
  </div>

  <p class="muted" style="margin-top: 20px;">
    Need exact item-name matching instead? <a href="/kitchen/sales-search/advanced">Use Advanced Search</a>.
  </p>
</div>

</body>
</html>
