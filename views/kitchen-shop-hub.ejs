<%- include('partials/head', { title: shop.name + " — QTR Kitchen Ordering" }) %>
<%- include('partials/topbar') %>

<div class="container">
  <p class="muted"><a href="/kitchen">&larr; All shops</a></p>
  <h1><%= shop.name %></h1>
  <p class="subtitle">Pick a category.</p>

  <div class="card">
    <% if (hasReports) { %>
      <div class="item-row">
        <span class="item-name">Sales Reports</span>
        <a class="btn btn-small" href="/kitchen/reports">Open</a>
      </div>
    <% } %>
    <div class="item-row">
      <span class="item-name">EOD Cash Reports</span>
      <a class="btn btn-small" href="/kitchen/shop/<%= shop.slug %>/eod-cash">Open</a>
    </div>
    <div class="item-row">
      <span class="item-name">Food Orders</span>
      <a class="btn btn-small" href="/kitchen/shop/<%= shop.slug %>/orders">Open</a>
    </div>
    <div class="item-row">
      <span class="item-name">Invoices</span>
      <a class="btn btn-small" href="/kitchen/shop/<%= shop.slug %>/invoices">Open</a>
    </div>
    <div class="item-row">
      <span class="item-name">Current COGS</span>
      <a class="btn btn-small" href="/kitchen/shop/<%= shop.slug %>/cogs">Open</a>
    </div>
    <div class="item-row">
      <span class="item-name">Baking List</span>
      <a class="btn btn-small" href="/kitchen/baking-list">Open</a>
    </div>
    <div class="item-row">
      <span class="item-name">Chia &amp; Oats Prep</span>
      <a class="btn btn-small" href="/kitchen/shop/<%= shop.slug %>/chia-oats-prep">Open</a>
    </div>
  </div>
</div>

</body>
</html>
