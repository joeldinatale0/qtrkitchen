<%- include('partials/head', { title: 'Staff Login — QTR Kitchen Ordering' }) %>

<div class="container">
  <form class="login-form" method="POST" action="/staff-login">
    <p class="muted" style="margin-bottom: 8px;"><a href="/">&larr; Back</a></p>
    <h1>Staff Login</h1>
    <p class="subtitle">Enter your 4-digit PIN.</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <div style="margin-bottom: 24px;">
      <label for="pin">PIN</label>
      <input
        type="password"
        id="pin"
        name="pin"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="4"
        autocomplete="off"
        style="width: 100%; font-size: 28px; letter-spacing: 8px; text-align: center;"
        required
        autofocus
      />
    </div>

    <button class="btn btn-filled" type="submit" style="width: 100%;">Continue</button>
  </form>
</div>

</body>
</html>
