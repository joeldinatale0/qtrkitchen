<%- include('partials/head', { title: "Stock Check — QTR Kitchen Ordering" }) %>
<%- include('partials/topbar') %>

<div class="container">
  <h1>Stocklist &amp; Par</h1>
  <p class="subtitle">Count what you've got left on the shelf for each item and enter it below.</p>

  <form method="GET" action="/stock-check" class="eod-meta" style="margin-bottom: 20px;">
    <div>
      <label for="date">Date</label>
      <input type="date" id="date" name="date" value="<%= checkDate %>" max="<%= today %>" onchange="this.form.submit()" />
    </div>
  </form>

  <% if (generated) { %>
    <div class="success-banner" style="margin-bottom: 20px;">Stock check saved for <%= formatDate(checkDate) %>.</div>
    <div class="card" style="margin-bottom: 30px;">
      <p class="item-name" style="margin-bottom: 8px;">Grab from the back</p>
      <% if (generated.length === 0) { %>
        <p class="muted">Nothing needed from the back today.</p>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Item</th><th>Grab</th><th>Have</th><th>Par</th></tr>
          </thead>
          <tbody>
            <% generated.forEach(function(r) { %>
              <tr>
                <td><strong><%= r.name %></strong></td>
                <td><%= r.shortfall %> <%= r.par_unit %></td>
                <td class="muted"><%= r.current_stock %></td>
                <td class="muted"><%= r.par_level %> <%= r.par_unit %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% } %>

  <% if (checklistItems.length === 0) { %>
    <p class="muted">No stocklist set up for this shop yet.</p>
  <% } else { %>
    <form method="POST" action="/stock-check">
      <input type="hidden" name="check_date" value="<%= checkDate %>" />
      <div class="card">
        <table>
          <thead>
            <tr><th>Item</th><th>Par</th><th>Current stock</th></tr>
          </thead>
          <tbody>
            <% checklistItems.forEach(function(item) { %>
              <tr>
                <td><%= item.name %></td>
                <td class="muted"><%= item.par_level %> <%= item.par_unit %></td>
                <td style="width: 120px;">
                  <input
                    type="number"
                    step="1"
                    min="0"
                    name="stock_<%= item.id %>"
                    style="width: 100px;"
                    value="<%= existingStock[item.id] !== undefined ? existingStock[item.id] : '' %>"
                  />
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 16px;">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="2" style="width: 100%;"><%= existingNotes %></textarea>
      </div>

      <button class="btn btn-filled" type="submit" style="margin-top: 16px;">
        <%= existing ? 'Update' : 'Submit' %> Stock Check
      </button>
    </form>
  <% } %>

  <% if (recent.length > 0) { %>
    <h2 style="margin-top: 40px;">Recent Stock Checks</h2>
    <div class="card">
      <table>
        <thead>
          <tr><th>Date</th><th>Submitted By</th><th></th></tr>
        </thead>
        <tbody>
          <% recent.forEach(function(s) { %>
            <tr>
              <td><%= formatDate(s.check_date) %></td>
              <td><%= s.submitted_by || '—' %></td>
              <td><a class="btn btn-small" href="/stock-check?date=<%= s.check_date %>">View / Edit</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

</body>
</html>
